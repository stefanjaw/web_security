<odoo>
  <data>
    
    <record model="ir.ui.view" id="web_security_res_users_form">
      <field name="name">Users web_security Form</field>
      <field name="model">res.users</field>
      <field name="inherit_id" ref="base.view_users_form"/> 
      <field name="arch" type="xml">
        <xpath expr="//notebook" position="before">
          <group>
            <field name="email_verified"/>
          </group>
        </xpath>
      </field>
    </record>
    
    <record model="ir.ui.view" id="web_security_res_users_search">
      <field name="name">Users web_security Search</field>
      <field name="model">res.users</field>
      <field name="inherit_id" ref="base.view_users_search"/> 
      <field name="arch" type="xml">
        <xpath expr="//search" position="inside">
            <separator/>
            <filter name="email_verified" string="Email Verified" domain="[('email_verified', '=', True)]"/>
            <group>
                <filter name="group_by_email_verified" domain="[]" context="{'group_by': 'email_verified'}"/>
            </group>
        </xpath>
      </field>
    </record>
      
  </data>
</odoo>