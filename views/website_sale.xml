<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="payment_submit_button_inherit_web_security" model="ir.ui.view">
            <field name="name">Payment Submit Button Inherit Web Security</field>
            <field name="priority">98</field>
            <field name="inherit_id" ref="payment.submit_button"/>
            <field name="arch" type="xml">
              <xpath expr="//button[@name='o_payment_submit_button']" position="before">
                    <t t-if="request.env.user.email_verified == False and request.env.company.email_verification == True">
                        <div style="display: flex;">
                            <t t-if="request.env.user.id == 4">
                                <a t-attf-href="/web/login?redirect=/web/login?redirect=/shop/payment" t-attf-class="#{_cta_classes} btn btn-secondary #{not website_sale_order._is_cart_ready() and 'disabled'} #{_form_send_navigation and 'order-lg-3 w-100 w-lg-auto ms-lg-auto' or 'w-100'}">Sign in</a>
                            </t>
                            <t t-else="">
                                <a t-attf-href="/web/reset_password?login={{ request.env.user.login }}" t-attf-class="#{_cta_classes} btn btn-secondary #{not website_sale_order._is_cart_ready() and 'disabled'} #{_form_send_navigation and 'order-lg-3 w-100 w-lg-auto ms-lg-auto' or 'w-100'}">Reset Password</a>
                            </t>
                        </div><br/>
                    </t>
              </xpath>
    
            </field>
        </record>

        <record id="website_sale_address_inherit_web_security" model="ir.ui.view">
            <field name="name">Address Management Inherit Web Security</field>
            <field name="priority">98</field>
            <field name="inherit_id" ref="website_sale.address"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='div_phone']" position="before">
                    <t t-if="request.env.user.id in [4,False,'', None]">
                        <div t-attf-class="#{error.get('phone') and 'o_has_error'} col-lg-6 mb-2" id="div_password">
                            <label
                                t-attf-class="col-form-label #{mode[1] == 'shipping' and 'label-optional' or ''}">Password Required*</label>
                            <input type="password" name="password" t-attf-class="form-control #{error.get('email') and 'is-invalid' or ''}"
                                t-att-value="'password' in checkout and checkout['password']"/>
                        </div>
                        <t t-if="request.params.get('error')">
                            <div class="alert alert-danger" role="alert">
                                <t t-out="request.params.get('error')"/>
                            </div>
                        </t>
                    </t>
                </xpath>
            </field>
        </record>
        
    </data>    
</odoo>
